Options -MultiViews
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==================================================
# Force non-www (canonical)
# ===================================================
RewriteCond %{HTTP_HOST} ^www\.solidgroundarena\.com$ [NC]
RewriteRule ^ https://solidgroundarena.com%{REQUEST_URI} [R=301,L]

# ==================================================
# Force HTTPS (ONLY enable after SSL is confirmed)
# ==================================================
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ==================================================
# Canonical homepage
# ==================================================
RewriteRule ^index/?$ / [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]

# ==================================================
# Legacy .html -> clean (EXPLICIT, no parentheses)
# ==================================================
RewriteRule ^sports\.html$ /sports [R=301,L]
RewriteRule ^shop\.html$ /shop [R=301,L]
RewriteRule ^volleyball\.html$ /volleyball [R=301,L]
RewriteRule ^derby\.html$ /derby [R=301,L]
RewriteRule ^arena-rental\.html$ /arena-rental [R=301,L]
RewriteRule ^birthdays\.html$ /birthdays [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
RewriteRule ^inline-hockey\.html$ /inline-hockey [R=301,L]
RewriteRule ^skate-night\.html$ /skate-night [R=301,L]
RewriteRule ^ARCHIVE\.html$ /ARCHIVE [R=301,L]

# ==================================================
# Clean URLs: /page -> page.html (internal rewrite)
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ==================================================
# Custom 404
# ==================================================
ErrorDocument 404 /404.html

# ==================================================
# Cache Control
# =================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
