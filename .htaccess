Options -MultiViews

# ==================================================
# Canonical domain (force no-www)
# ==================================================
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.solidgroundarena\.com$ [NC]
RewriteRule ^ https://solidgroundarena.com%{REQUEST_URI} [R=301,L]

# ==================================================
# Force HTTPS (ONLY enable after SSL is confirmed)
# ==================================================
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ==================================================
# Canonical homepage
# ==================================================
Redirect 301 /index.html /
Redirect 301 /index /

# ==================================================
# Legacy .html URLs -> clean URLs (SEO-critical)
# ==================================================
Redirect 301 /sports.html /sports
Redirect 301 /shop.html /shop
Redirect 301 /volleyball.html /volleyball
Redirect 301 /derby.html /derby
Redirect 301 /arena-rental.html /arena-rental
Redirect 301 /birthdays.html /birthdays
Redirect 301 /contact.html /contact
Redirect 301 /inline-hockey.html /inline-hockey
Redirect 301 /skate-night.html /skate-night
Redirect 301 /ARCHIVE.html /ARCHIVE

# ==================================================
# Clean URLs: /page -> page.html (internal rewrite)
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ==================================================
# Custom 404
# ==================================================
ErrorDocument 404 /404.html
